; Maze Tower Defense - Godot project configuration
; Engine configuration file.

config_version=5

[application]

config/name="MazeTD"
config/description="网格迷宫塔防：敌人真实寻路，塔会改变通路。程序化生成全部美术与音效。"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="MazeTD_userdata"

[display]

window/size/viewport_width=1240
window/size/viewport_height=760
window/size/resizable=false
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=0
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.075, 1)

[physics]

common/physics_ticks_per_second=60
common/max_fps=0

[audio]

buses/default_bus_layout=""

[debug]

file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false
